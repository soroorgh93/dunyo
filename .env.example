# ---------- Dunyo configuration (copy to .env; never commit .env) ----------
# Data mode: auto (live, falls back to the synthetic replay world) | live | replay
TS_MODE=auto
# Deep models on/off (needs PyTorch) and training epochs
TS_DEEP=1
TS_DEEP_EPOCHS=6

# ---------- Optional LLM planner/critic/reporter: any OpenAI-compatible endpoint ----------
# Groq (free tier):    LLM_BASE_URL=https://api.groq.com/openai/v1          LLM_MODEL=llama-3.3-70b-versatile
# Google Gemini:       LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# OpenAI:              LLM_BASE_URL=https://api.openai.com/v1                LLM_MODEL=gpt-4o-mini
# Ollama (local):      LLM_BASE_URL=http://localhost:11434/v1                LLM_MODEL=qwen2.5:7b   (LLM_API_KEY=ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- Optional public blockchain (Sepolia testnet) ----------
# Without these, reports are anchored on an in-process EVM (or the local hash-chained ledger).
# CHAIN_MODE: auto | ledger | evm-local | evm-rpc
CHAIN_MODE=auto
RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=

# ---------- Optional: your contact for the Open Food Facts User-Agent (they ask apps to identify themselves) ----------
DUNYO_CONTACT=
